# Preview build of branch unit-orders (StrCoder911/Blue) for play-testing at cloudspace.dk/blue-preview/unit-orders/
# Hide the Git metadata the Hostinger deploy leaves in this folder.
RedirectMatch 404 /\.git
# Always revalidate the page itself so new builds show up at once;
# hashed files under assets/ can be cached long.
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access 1 year"
</IfModule>
